{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Workflow Registry",
  "type": "object",
  "required": ["registry_name", "version", "workflows"],
  "properties": {
    "registry_name": {"type": "string"},
    "version": {"type": "string"},
    "workflows": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "ai_system", "pillar", "supporting_practice", "use_case", "orchestration_logic", "supported_uploads", "customer_upload_supported", "execution_mode", "evidence_source", "replay_behavior", "frontend_routing", "report_template", "implementation_status", "automation_level"],
        "properties": {
          "customer_upload_supported": {"const": false},
          "execution_mode": {"const": "synthetic_demo"},
          "orchestration_logic": {"type": "array", "items": {"type": "string"}},
          "supported_uploads": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
