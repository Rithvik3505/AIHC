{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluator Registry",
  "type": "object",
  "required": ["registry_name", "version", "evaluators"],
  "properties": {
    "registry_name": {"type": "string"},
    "version": {"type": "string"},
    "evaluators": {
      "type": "array",
      "items": {
        "type": "object",
        "anyOf": [
          {
            "required": ["id", "evaluator_type", "scoring_method", "supported_practices", "supported_ai_systems", "deterministic", "llm_or_statistical"]
          },
          {
            "required": ["id", "implementation_module", "supported_test_ids", "required_evidence", "algorithm_family", "deterministic", "implementation_status", "known_limitations"]
          }
        ]
      }
    }
  }
}
