{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Registry",
  "type": "object",
  "required": ["registry_name", "version", "benchmarks"],
  "properties": {
    "registry_name": {"type": "string"},
    "version": {"type": "string"},
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "benchmark_type", "metric", "source", "source_url", "publication", "publication_date", "version", "evaluator_version_compatibility", "applicability", "limitations", "normalization_method", "empirical", "peer_grouping", "distribution"],
        "properties": {
          "benchmark_type": {"enum": ["synthetic_reference", "external_reference", "historical_customer_baseline", "policy_threshold", "industry_peer_distribution"]},
          "source_url": {"type": ["string", "null"]},
          "publication_date": {"type": ["string", "null"]},
          "normalization_method": {"type": ["string", "null"]},
          "empirical": {"type": "boolean"},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "evaluator_version_compatibility": {"type": "array", "items": {"type": "string"}},
          "peer_grouping": {"type": "array", "items": {"type": "string"}},
          "distribution": {"type": "array", "items": {"type": "number"}}
        }
      }
    }
  }
}
