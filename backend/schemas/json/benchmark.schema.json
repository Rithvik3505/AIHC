{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Benchmark Registry",
  "type": "object",
  "required": ["registry_name", "version", "benchmarks"],
  "properties": {
    "registry_name": {"type": "string"},
    "version": {"type": "string"},
    "benchmarks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "benchmark_metric", "percentile_logic", "peer_grouping", "benchmark_type", "provenance", "generation_method", "sample_size", "evaluator_version_compatibility", "limitations", "synthetic_benchmark_distribution", "scoring_normalization"],
        "properties": {
          "benchmark_type": {"const": "illustrative_synthetic_reference"},
          "sample_size": {"type": "integer", "minimum": 0},
          "limitations": {"type": "array", "items": {"type": "string"}},
          "evaluator_version_compatibility": {"type": "array", "items": {"type": "string"}}
        }
      }
    }
  }
}
