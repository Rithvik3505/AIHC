{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Evaluation Result",
  "type": "object",
  "required": ["outputs", "aggregate_score", "aggregate_risk_level", "coverage", "benchmark_indicator"],
  "properties": {
    "outputs": {"type": "array"},
    "aggregate_score": {"type": ["integer", "null"], "minimum": 0, "maximum": 100},
    "aggregate_risk_level": {"anyOf": [{"enum": ["Low", "Medium", "High"]}, {"type": "null"}]},
    "coverage": {
      "type": "object",
      "required": [
        "selected_test_count",
        "completed_count",
        "insufficient_evidence_count",
        "not_implemented_count",
        "failed_count",
        "score_coverage_percentage"
      ],
      "properties": {
        "selected_test_count": {"type": "integer", "minimum": 0},
        "completed_count": {"type": "integer", "minimum": 0},
        "insufficient_evidence_count": {"type": "integer", "minimum": 0},
        "not_implemented_count": {"type": "integer", "minimum": 0},
        "failed_count": {"type": "integer", "minimum": 0},
        "score_coverage_percentage": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "benchmark_indicator": {"type": "object"}
  }
}
